{
  "functions": {
    "api/[recurso].js": {
      "includeFiles": "data/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/funcionarios",
      "destination": "/index.html"
    }
  ]
}
