{
  "functions": {
    "api/catalogo.js": {
      "includeFiles": "data/**"
    },
    "api/precos.js": {
      "includeFiles": "data/**"
    },
    "api/importar.js": {
      "maxDuration": 60
    },
    "api/restaurar.js": {
      "maxDuration": 60
    },
    "api/migrar.js": {
      "maxDuration": 60
    },
    "api/backup.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/data/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
